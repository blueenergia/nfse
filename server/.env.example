# ==========================================
# Configurações do Microserviço Blue NFSe
# ==========================================

# Ambiente SEFIN (true = Homologação / Testes; false = Produção)
AMBIENTE_HOMOLOGACAO=true

# Senhas dos Certificados Digitais A1 (arquivos devem estar em ./certs)
CERTIFICADO_SENHA=sua_senha_do_certificado_pfx
CADEIA_CERTIFICADOS_SENHA=senha_cacerts

# Dados Fiscais da Blue Energia (Imperatriz - MA)
PRESTADOR_CNPJ=62967464000129
PRESTADOR_IM=428469638
PRESTADOR_MUNICIPIO_IBGE=2105302
DPS_SERIE=70000
DPS_NUMERO_INICIAL=218

# Segurança da API
API_KEY=sua_chave_secreta_para_header_x_api_key

# Criptografia de Ponta a Ponta AES-256-GCM (opcional, preencha para ativar /api/nfse/emitir/secure)
ENCRYPTION_KEY=sua_senha_ou_segredo_para_criptografia_aes_256

# Token do Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=seu_token_do_cloudflare_tunnel
